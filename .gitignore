# piri distribution ships the frozen provider model catalogs (data/) so a fresh
# clone is runnable without re-running model generation against each provider.
# (Upstream Pi gitignores these because it regenerates them; piri freezes them.)

# Environment
.env

# Per-node deployment artifacts (NOT part of the distribution; created at deploy)
# piri-ccc.sh bakes in the node's model (e.g. zai/glm-5.2 or kimi-coding/k3);
# credentials live in ~/.piri/agent/auth.json, never in this repo.
piri-ccc.sh

